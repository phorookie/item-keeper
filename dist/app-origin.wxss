page{--bg:#fafaf8;--surface:#fff;--surface-alt:#f3f2ef;--text-primary:#1c1b1a;--text-secondary:#6b6966;--text-tertiary:#9a9793;--text-disabled:#c4c1bc;--accent:#5b8c6f;--accent-soft:#e8f0eb;--accent-hover:#4a755d;--warning:#b8864a;--warning-soft:#f7eee1;--danger:#b85c4a;--danger-soft:#f7e5e1;--border:#e8e6e2;--border-light:#f0eeeb;--radius-sm:12rpx;--radius-md:20rpx;--radius-lg:32rpx;background-color:var(--bg);color:var(--text-primary);font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Hiragino Sans GB,Microsoft YaHei,sans-serif;font-size:28rpx;line-height:1.6}text,view{-webkit-box-sizing:border-box;box-sizing:border-box}.flex{display:-webkit-flex;display:-ms-flexbox;display:flex}.flex-col{-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column}.flex-center{-ms-flex-align:center;-ms-flex-pack:center;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center}.flex-between{-ms-flex-pack:justify;-webkit-justify-content:space-between;justify-content:space-between}.flex-1{-webkit-flex:1;-ms-flex:1;flex:1}.text-primary{color:var(--text-primary)}.text-secondary{color:var(--text-secondary)}.text-tertiary{color:var(--text-tertiary)}.text-warning{color:var(--warning)}.ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}