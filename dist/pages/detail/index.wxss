.detail{background:var(--surface);min-height:100vh}.detail--loading{-ms-flex-align:center;-ms-flex-pack:center;-webkit-align-items:center;align-items:center;color:var(--text-tertiary);display:-webkit-flex;display:-ms-flexbox;display:flex;font-size:28rpx;-webkit-justify-content:center;justify-content:center}.detail__scroll{height:100vh}.detail__hero{-ms-flex-align:center;-ms-flex-pack:center;-webkit-align-items:center;align-items:center;background:-webkit-gradient(linear,left top,left bottom,from(#f3f2ef),to(#fafaf8));background:-webkit-linear-gradient(top,#f3f2ef,#fafaf8);background:linear-gradient(180deg,#f3f2ef,#fafaf8);display:-webkit-flex;display:-ms-flexbox;display:flex;height:500rpx;-webkit-justify-content:center;justify-content:center}.detail__hero-swiper{height:100%;width:100%}.detail__hero-img{height:500rpx;width:100%}.detail__hero-placeholder{font-size:160rpx;opacity:.2}.detail__hero-icon{font-size:160rpx;opacity:.2}.detail__body{background:var(--surface);border-radius:48rpx 48rpx 0 0;margin-top:-40rpx;min-height:calc(100vh - 500rpx);padding:56rpx 48rpx 60rpx;position:relative;z-index:1}.detail__title{color:var(--text-primary);display:block;font-size:44rpx;font-weight:500;letter-spacing:-.5rpx;margin-bottom:12rpx}.detail__category{color:var(--text-tertiary);display:block;font-size:26rpx;margin-bottom:32rpx}.detail__status{-ms-flex-align:center;-webkit-align-items:center;align-items:center;background:var(--warning-soft);border-radius:var(--radius-md);display:-webkit-flex;display:-ms-flexbox;display:flex;gap:16rpx;margin-bottom:48rpx;padding:28rpx 32rpx}.detail__status-icon{-ms-flex-negative:0;-webkit-flex-shrink:0;flex-shrink:0;font-size:32rpx}.detail__status-text{color:var(--warning);-webkit-flex:1;-ms-flex:1;flex:1;font-size:26rpx;line-height:1.5}.detail__section{margin-bottom:48rpx}.detail__section-title{color:var(--text-tertiary);display:block;font-size:22rpx;font-weight:500;letter-spacing:2rpx;margin-bottom:24rpx;text-transform:uppercase}.detail__tags{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:16rpx}.detail__info-list{background:var(--surface)}.detail__info-row{-ms-flex-pack:justify;-ms-flex-align:center;-webkit-align-items:center;align-items:center;border-bottom:1rpx solid var(--border-light);display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;justify-content:space-between;padding:24rpx 0}.detail__info-row:last-child{border-bottom:none}.detail__info-label{color:var(--text-secondary);font-size:28rpx}.detail__info-value{color:var(--text-primary);font-size:28rpx}.detail__info-value--warning{color:var(--warning)}.detail__note{color:var(--text-secondary);font-size:28rpx;line-height:1.8}.detail__actions{display:-webkit-flex;display:-ms-flexbox;display:flex;gap:20rpx;margin-top:16rpx;padding-bottom:env(safe-area-inset-bottom)}.detail__btn{border-radius:100rpx;-webkit-flex:1;-ms-flex:1;flex:1;font-size:28rpx;font-weight:500;padding:28rpx;text-align:center}.detail__btn--primary{background:var(--text-primary);color:var(--surface)}.detail__btn--ghost{background:transparent;border:1rpx solid var(--border);color:var(--text-secondary)}.detail__btn:active{opacity:.8}